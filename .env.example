DATABASE_URL=postgresql://postgres:postgres@localhost:5432/indieforge?schema=public
# Required: set a randomly generated secret before starting the API. For example:
# openssl rand -hex 32
JWT_SECRET=
# API listener port. The web application is configured to call this origin by default.
API_PORT=3001
# Browser origin permitted to send credentialed requests to the API.
WEB_ORIGIN=http://localhost:3000
# Browser-visible API base URL used by the Next.js application.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Local object storage for uploaded zips. Omit to keep files in memory (tests).
STORAGE_DIR=.data/objects
# Cloudflare R2 (S3-compatible). When bucket + keys + endpoint/account are set,
# create-version returns a presigned PUT URL instead of /uploads/:token.
# The bucket CORS policy must allow PUT from WEB_ORIGIN with
# Content-Type: application/octet-stream. Names only — never commit secrets.
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_ENDPOINT=
# CLOUDFLARE_R2_DEFAULT_REGION=auto
# CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=true
# Sandbox donations (USD cents). Fee is basis points of the gift (1000 = 10%).
DONATION_FEE_BPS=1000
SANDBOX_DONATION_WEBHOOK_SECRET=change-me
