DATABASE_URL=postgresql://postgres:postgres@localhost:5432/indieforge?schema=public
# Required: set a randomly generated secret before starting the API. For example:
# openssl rand -hex 32
JWT_SECRET=
# API listener port. The web application is configured to call this origin by default.
API_PORT=3001
# Browser origin permitted to send credentialed requests to the API.
WEB_ORIGIN=http://localhost:3000
# Browser-visible API base URL used by the Next.js application.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Local object storage for uploaded zips. Omit to keep files in memory (tests).
STORAGE_DIR=.data/objects
