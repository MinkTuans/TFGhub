# Public address handled by Caddy. Use :80 for HTTP on a bare server IP.
DEPLOY_ADDRESS=:80

# Host port published for HTTP traffic.
HTTP_PORT=80

# Exact browser-visible origin, including scheme and any non-default port.
SITE_ORIGIN=http://localhost

# Keep true for HTTPS. Set false explicitly only for a bare-IP HTTP preview.
COOKIE_SECURE=true

# AdSense is disabled for the current test deployment. Enabling it requires a
# valid ca-pub client, both numeric slot IDs, and a deliberate CSP review.
# These public values are compiled into the web image; rebuild after changing.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_GAME_LEFT_TOP_SLOT=
NEXT_PUBLIC_ADSENSE_GAME_LEFT_BOTTOM_SLOT=

# Immutable HTML5 artifacts and covers/ share Docker's named game_storage volume.
# Game ZIP uploads: 25 MiB (26214400 bytes). JPEG/PNG/WebP covers: 5 MiB (5242880 bytes).

# PostgreSQL database and application role.
POSTGRES_DB=indieforge
POSTGRES_USER=indieforge

# POSTGRES_PASSWORD must be URL-safe hexadecimal because Compose inserts it
# directly into DATABASE_URL. Generate it with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Generate an independent JWT signing secret with: openssl rand -hex 32
JWT_SECRET=
