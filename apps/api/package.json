{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build:packages": "pnpm --filter '@indieforge/*' build",
    "build": "pnpm run build:packages && nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "pnpm run build:packages && nest start",
    "dev": "pnpm run build:packages && nest start --watch",
    "start:dev": "pnpm run dev",
    "start:debug": "pnpm run build:packages && nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "typecheck": "pnpm --workspace-root db:generate && tsc --noEmit --project tsconfig.build.json",
    "test": "pnpm run build:packages && vitest run",
    "test:watch": "pnpm run build:packages && vitest",
    "test:cov": "pnpm run build:packages && vitest run --coverage",
    "test:debug": "pnpm run build:packages && vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "pnpm run build:packages && vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@indieforge/contracts": "workspace:^",
    "@indieforge/database": "workspace:^",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "phaser": "3.80.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
