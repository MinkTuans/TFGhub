{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:contracts": "pnpm --filter @indieforge/contracts build",
    "test": "pnpm run build:contracts && sh -c 'if [ \"$1\" = \"--\" ]; then shift; fi; exec pnpm exec vitest run \"$@\"' --",
    "e2e": "playwright test",
    "dev": "pnpm run build:contracts && next dev",
    "build": "pnpm run build:contracts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@indieforge/contracts": "workspace:^",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10",
    "remark-gfm": "4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
