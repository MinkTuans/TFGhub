generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum GameVisibility {
  DRAFT
  PUBLIC
  UNLISTED
}

enum GameAccessMode {
  GUEST_ALLOWED
  AUTH_REQUIRED
}

enum ModerationState {
  CLEAR
  FLAGGED
  QUARANTINED
}

enum GameVersionStatus {
  UPLOADING
  SCANNING
  READY
  REJECTED
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  role         UserRole          @default(USER)
  createdAt    DateTime          @default(now())
  profile      DeveloperProfile?
  games        Game[]
}

model DeveloperProfile {
  userId      String   @id
  displayName String
  bio         String   @default("")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Game {
  id              String          @id @default(cuid())
  ownerId         String
  slug            String          @unique
  title           String
  description     String          @default("")
  visibility      GameVisibility  @default(DRAFT)
  accessMode      GameAccessMode  @default(GUEST_ALLOWED)
  moderationState ModerationState @default(CLEAR)
  activeVersionId String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions        GameVersion[]
  activeVersion   GameVersion?    @relation("ActiveGameVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
}

model GameVersion {
  id              String            @id @default(cuid())
  gameId          String
  status          GameVersionStatus @default(UPLOADING)
  filename        String
  byteSize        Int
  checksumSha256  String
  storageKey      String
  findings        String            @default("")
  uploadToken     String?           @unique
  uploadExpiresAt DateTime?
  createdAt       DateTime          @default(now())
  game            Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  publishedFor    Game?             @relation("ActiveGameVersion")

  @@index([gameId, createdAt])
}
