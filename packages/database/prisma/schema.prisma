generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum GameVisibility {
  DRAFT
  PUBLIC
  UNLISTED
}

enum GameAccessMode {
  GUEST_ALLOWED
  AUTH_REQUIRED
}

enum ModerationState {
  CLEAR
  FLAGGED
  QUARANTINED
}

enum GameVersionStatus {
  UPLOADING
  SCANNING
  READY
  REJECTED
}

enum DonationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ReportCategory {
  MALWARE
  PROHIBITED
  COPYRIGHT
  IMPERSONATION
  MISLEADING
}

enum ReportStatus {
  OPEN
  DISMISSED
  APPEALED
  RESTORED
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  role         UserRole          @default(USER)
  createdAt    DateTime          @default(now())
  profile      DeveloperProfile?
  games        Game[]
  donationsGiven    Donation[] @relation("DonationDonor")
  donationsReceived Donation[] @relation("DonationRecipient")
  reportsFiled      Report[]   @relation("ReportReporter")
}

model DeveloperProfile {
  userId      String   @id
  displayName String
  bio         String   @default("")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Game {
  id              String          @id @default(cuid())
  ownerId         String
  slug            String          @unique
  title           String
  description     String          @default("")
  visibility      GameVisibility  @default(DRAFT)
  accessMode      GameAccessMode  @default(GUEST_ALLOWED)
  moderationState  ModerationState @default(CLEAR)
  moderationReason String          @default("")
  activeVersionId  String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions        GameVersion[]
  donations       Donation[]
  playSessions    PlaySession[]
  reports         Report[]
  project         GameProject?
  activeVersion   GameVersion?    @relation("ActiveGameVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
}

model GameProject {
  id            String   @id @default(cuid())
  gameId        String   @unique
  templateId    String
  formatVersion String   @default("1")
  document      Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model Donation {
  id               String         @id @default(cuid())
  gameId           String
  donorId          String
  recipientId      String
  amountCents      Int
  feeCents         Int
  currency         String         @default("USD")
  status           DonationStatus @default(PENDING)
  idempotencyKey   String
  provider         String         @default("sandbox")
  providerEventId  String?        @unique
  createdAt        DateTime       @default(now())
  game             Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  donor            User           @relation("DonationDonor", fields: [donorId], references: [id], onDelete: Cascade)
  recipient        User           @relation("DonationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([donorId, idempotencyKey])
  @@index([recipientId, createdAt])
}

model GameVersion {
  id              String            @id @default(cuid())
  gameId          String
  status          GameVersionStatus @default(UPLOADING)
  filename        String
  byteSize        Int
  checksumSha256  String
  storageKey      String
  findings        String            @default("")
  uploadToken     String?           @unique
  uploadExpiresAt DateTime?
  createdAt       DateTime          @default(now())
  game            Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  publishedFor    Game?             @relation("ActiveGameVersion")

  @@index([gameId, createdAt])
}

model PlaySession {
  id              String          @id @default(cuid())
  gameId          String
  visitorId       String
  valid           Boolean         @default(true)
  countedSeconds  Int             @default(0)
  lastHeartbeatAt DateTime?
  createdAt       DateTime        @default(now())
  game            Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  heartbeats      PlayHeartbeat[]

  @@index([gameId, visitorId, createdAt])
}

model Report {
  id                String         @id @default(cuid())
  gameId            String
  reporterId        String
  category          ReportCategory
  evidence          String
  status            ReportStatus   @default(OPEN)
  appealMessage     String         @default("")
  resolutionReason  String         @default("")
  createdAt         DateTime       @default(now())
  game              Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  reporter          User           @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([gameId, reporterId])
}

model PlayHeartbeat {
  id        String      @id @default(cuid())
  sessionId String
  eventId   String      @unique
  visible   Boolean
  active    Boolean
  counted   Boolean     @default(false)
  createdAt DateTime    @default(now())
  session   PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
